# OpenWeather API key: https://home.openweathermap.org/api_keys
VITE_OPENWEATHER_API_KEY=your_api_key_here

# API endpoints (usually no need to change)
VITE_WEATHER_API_BASE=https://api.openweathermap.org/data/2.5
VITE_GEO_API_BASE=https://api.openweathermap.org/geo/1.0

# Optional: city shown on first load. Defaults to Madrid coordinates.
VITE_DEFAULT_CITY=
